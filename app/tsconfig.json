{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@grafo": ["../meta/grafo.json"]
    }
  },
  "include": ["src/**/*", "**/*.config.*"],
  "exclude": ["dist", "node_modules"]
}
