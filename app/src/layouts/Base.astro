---
// Base.astro — Layout raíz_ con la estética brutalista minimalista original.
// Migrado 1:1 de /home/jojan/proyectos/ciberapp-prototype/index.html
// NO romper la paleta ni las proporciones; es la firma visual del producto.

export interface Props {
  title?: string;
  tag?: string;       // texto del pill de la navbar (ej: "Módulo 0 · Lección 01")
  view?: 'landing' | 'leccion' | 'modulo' | 'glosario' | 'grafo';
}

const {
  title = 'raíz_ · ciberseguridad desde el cimiento',
  tag = 'v0.1',
  view = 'landing',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-family='monospace' font-size='14'>▌</text></svg>" />
  <style is:global>
    :root {
      --bg: #ffffff;
      --paper: #fbfbfa;
      --ink: #18181b;
      --muted: #71717a;
      --faint: #a1a1aa;
      --line: rgba(24,24,27,.08);
      --line-2: rgba(24,24,27,.12);
      --accent: #5b5bd6;
      --accent-soft: #eeeefb;
      --accent-2: #0ea5e9;
      --c1: #5b5bd6; --c2: #0ea5e9; --c3: #10b981; --c4: #f59e0b; --c5: #f43f5e; --c6: #8b5cf6;

      /* estados del skill tree */
      --st-done: #10b981;
      --st-active: #5b5bd6;
      --st-locked: #d4d4d8;
      --st-weak: #f59e0b;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      scroll-behavior: smooth;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
      font-size: 17px;
      line-height: 1.6;
      display: flex;
      justify-content: center;
    }
    .mono { font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; }

    #app {
      width: 100%;
      max-width: 760px;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    /* nav */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 26px;
      border-bottom: 1px solid var(--line);
    }
    .brand {
      font-family: ui-monospace, Menlo, monospace;
      font-weight: 600;
      font-size: 16px;
      letter-spacing: -.01em;
      text-decoration: none;
      color: var(--ink);
    }
    .brand .cur { color: var(--accent); animation: blink 1.2s steps(2,start) infinite; }
    @keyframes blink { 0%,50%{opacity:1} 51%,100%{opacity:0} }
    .tag {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 12px;
      color: var(--faint);
      border: 1px solid var(--line);
      border-radius: 99px;
      padding: 5px 11px;
    }
    .nav-right { display: flex; gap: 10px; align-items: center; }

    /* views */
    .view { flex: 1; display: flex; flex-direction: column; }
    .hide { display: none; }
    .enter { animation: enter .5s cubic-bezier(.2,.7,.2,1); }
    @keyframes enter {
      from { opacity: 0; transform: translateY(12px); filter: blur(3px); }
      to   { opacity: 1; transform: none; filter: none; }
    }

    /* landing */
    .hero {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 48px 26px 60px;
      gap: 6px;
    }
    .ascii {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 13px;
      line-height: 1.32;
      letter-spacing: 1px;
      margin-bottom: 30px;
      user-select: none;
      white-space: pre;
    }
    h1 {
      font-size: 40px;
      line-height: 1.08;
      letter-spacing: -.025em;
      font-weight: 680;
      margin: 0 0 16px;
      text-wrap: balance;
      max-width: 14ch;
    }
    .lede {
      font-size: 18px;
      color: var(--muted);
      margin: 0 0 32px;
      text-wrap: pretty;
      max-width: 42ch;
    }
    .kbd {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 13px;
      color: var(--accent);
      background: var(--accent-soft);
      border-radius: 6px;
      padding: 2px 7px;
    }

    /* buttons */
    .btn {
      font: inherit;
      font-weight: 600;
      font-size: 16px;
      border: 0;
      border-radius: 13px;
      padding: 15px 26px;
      cursor: pointer;
      background: var(--ink);
      color: #fff;
      transition-property: transform,box-shadow,background-color;
      transition-duration: 160ms;
      transition-timing-function: ease-out;
      box-shadow: 0 1px 2px rgba(24,24,27,.18), 0 4px 14px rgba(24,24,27,.12);
      text-decoration: none;
      display: inline-block;
    }
    .btn:hover { background: #000; }
    .btn:active { transform: scale(.96); box-shadow: 0 1px 2px rgba(24,24,27,.2); }
    .btn.ghost {
      background: transparent;
      color: var(--ink);
      border: 1px solid var(--line-2);
      box-shadow: none;
    }
    .btn.ghost:hover { background: var(--paper); }
    .btn:disabled {
      background: var(--paper);
      color: var(--faint);
      box-shadow: none;
      cursor: not-allowed;
      border: 1px solid var(--line);
    }

    /* lesson */
    .lread { padding: 34px 26px 40px; }
    .crumb {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 12px;
      letter-spacing: .08em;
      color: var(--accent);
      margin-bottom: 14px;
    }
    .lread h2 {
      font-size: 30px;
      line-height: 1.12;
      letter-spacing: -.02em;
      font-weight: 680;
      margin: 0 0 22px;
      text-wrap: balance;
    }
    .lread p {
      font-size: 18px;
      line-height: 1.7;
      color: #27272a;
      margin: 0 0 20px;
      text-wrap: pretty;
    }
    .lread p.cold { font-size: 20px; color: var(--ink); }
    .lread b { font-weight: 650; color: var(--ink); }
    .accent-word { color: var(--accent); font-weight: 650; }

    /* glossary term click */
    .term {
      color: var(--accent);
      cursor: pointer;
      border-bottom: 1px dashed var(--accent);
      text-decoration: none;
    }
    .term:hover { background: var(--accent-soft); }

    .rule { height: 1px; background: var(--line); margin: 30px 0; border: 0; }

    .ascii-in {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 12px;
      line-height: 1.35;
      white-space: pre;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 20px;
      overflow-x: auto;
      margin: 26px 0;
      user-select: none;
    }

    /* lab card */
    .lab {
      border: 1px solid var(--line-2);
      border-radius: 18px;
      padding: 24px;
      margin: 28px 0;
      background: var(--bg);
    }
    .lab .lab-k {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--faint);
      margin-bottom: 6px;
    }
    .lab .lab-q { font-size: 16px; color: var(--muted); margin: 0 0 22px; text-wrap: pretty; }
    .switch-row { display: flex; align-items: center; justify-content: center; gap: 26px; }
    .toggle {
      width: 96px;
      height: 56px;
      border-radius: 99px;
      border: 1px solid var(--line-2);
      background: var(--paper);
      position: relative;
      cursor: pointer;
      transition-property: background-color,border-color;
      transition-duration: 200ms;
      transition-timing-function: ease-out;
    }
    .toggle .knob {
      position: absolute;
      top: 5px;
      left: 5px;
      width: 44px;
      height: 44px;
      border-radius: 99px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(24,24,27,.25), 0 3px 8px rgba(24,24,27,.12);
      transition-property: transform;
      transition-duration: 220ms;
      transition-timing-function: cubic-bezier(.5,1.4,.5,1);
    }
    .toggle.on { background: var(--accent); border-color: var(--accent); }
    .toggle.on .knob { transform: translateX(40px); }
    .readout {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 52px;
      font-weight: 600;
      width: 60px;
      text-align: center;
      font-variant-numeric: tabular-nums;
      color: var(--ink);
    }
    .readout small {
      display: block;
      font-family: "Inter", system-ui, sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--faint);
      margin-top: 4px;
    }

    .note {
      font-size: 15px;
      color: var(--muted);
      border-left: 2px solid var(--accent);
      padding-left: 16px;
      margin: 26px 0;
      text-wrap: pretty;
    }

    /* skill tree */
    .tree { padding: 24px 26px; }
    .phase {
      margin-bottom: 28px;
    }
    .phase-title {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--faint);
      margin: 0 0 12px;
    }
    .modules { display: grid; grid-template-columns: repeat(auto-fill,minmax(140px,1fr)); gap: 12px; }
    .mod {
      border: 1px solid var(--line-2);
      border-radius: 14px;
      padding: 14px 16px;
      background: var(--bg);
      text-decoration: none;
      color: var(--ink);
      position: relative;
      transition: transform 160ms ease-out, border-color 160ms ease-out;
    }
    .mod:hover { transform: translateY(-2px); border-color: var(--accent); }
    .mod .mod-id {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 11px;
      color: var(--faint);
    }
    .mod .mod-title { font-weight: 600; font-size: 14px; margin-top: 2px; line-height: 1.25; }
    .mod .mod-bar {
      height: 4px;
      background: var(--line);
      border-radius: 2px;
      margin-top: 10px;
      overflow: hidden;
    }
    .mod .mod-bar > span {
      display: block;
      height: 100%;
      background: var(--st-active);
    }
    .mod.locked { opacity: .45; cursor: not-allowed; }
    .mod.locked .mod-bar > span { background: var(--st-locked); }
    .mod.done .mod-bar > span { background: var(--st-done); }
    .mod.weak .mod-bar > span { background: var(--st-weak); }

    /* footer */
    footer {
      padding: 24px 26px;
      border-top: 1px solid var(--line);
      color: var(--faint);
      font-size: 13px;
      text-align: center;
    }
    .backlink {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: ui-monospace, Menlo, monospace;
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
      padding: 10px 0;
      cursor: pointer;
      min-height: 40px;
    }
    .backlink:hover { color: var(--ink); }

    /* flashcard */
    .flashcard {
      perspective: 1000px;
      width: 100%;
      max-width: 360px;
      height: 220px;
      margin: 0 auto;
      cursor: pointer;
    }
    .flashcard .inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 500ms cubic-bezier(.2,.7,.2,1);
      transform-style: preserve-3d;
    }
    .flashcard.flipped .inner { transform: rotateY(180deg); }
    .flashcard .face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border: 1px solid var(--line-2);
      border-radius: 18px;
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .flashcard .face.back { transform: rotateY(180deg); background: var(--accent-soft); }
    .flashcard .face .label {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--faint);
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <div id="app">
    <nav>
      <a class="brand" href="/">raíz<span class="cur">_</span></a>
      <div class="nav-right">
        <a class="tag" href="/grafo">skill tree</a>
        <a class="tag" href="/glosario">glosario</a>
        <slot name="nav-extra" />
      </div>
    </nav>

    <slot />

    <footer>raíz_ · carrera técnica de hacking ofensivo · en español · desde cero</footer>
  </div>
</body>
</html>
