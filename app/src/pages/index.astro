---
import Base from '../layouts/Base.astro';
import grafo from '../../meta/grafo.json';
---

<Base view="landing">
  <section class="view enter" slot="default">
    <div class="hero">
      <div class="ascii" aria-hidden="true">
<span style="color:var(--c1)">●</span>───────<span style="color:var(--c4)">●</span>
│ ╲   ╱ │
│   <span style="color:var(--c5)">●</span>   │
│ ╱   ╲ │
<span style="color:var(--c3)">●</span>───────<span style="color:var(--c2)">●</span>
      </div>
      <h1>Ciberseguridad desde el cimiento absoluto.</h1>
      <p class="lede">
        No asumimos que sabés nada. Empezamos donde la electricidad se vuelve información —
        y no paramos hasta el exploit. <span class="kbd">21 módulos</span> ·
        <span class="kbd">~222 lecciones</span> · <span class="kbd">grafo dirigido</span>.
      </p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
        <a class="btn" href="/grafo">Ver el skill tree completo</a>
        <a class="btn ghost" href="/m/M0">Empezar por M0 · El bit</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // pequeña vibración al hover (mantiene el lenguaje del prototipo)
  document.querySelectorAll('.btn').forEach(b=>{
    b.addEventListener('click',()=>navigator.vibrate&&navigator.vibrate(12));
  });
</script>
