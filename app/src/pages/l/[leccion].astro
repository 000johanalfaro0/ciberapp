---
import Base from '../../layouts/Base.astro';
import Toggle from '../../components/Toggle.astro';
import CipherXor from '../../components/CipherXor.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lecciones = await getCollection('lecciones');
  return lecciones.map(l => ({
    params: { leccion: l.data.id || l.id },
    props: { leccion: l },
  }));
}

const { leccion } = Astro.props;

let Content = null;
if (leccion) {
  try {
    const rendered = await render(leccion);
    Content = rendered.Content;
  } catch (e) {
    console.error('render falló para', leccion?.id, e.message);
  }
}

const titulo  = leccion?.data?.titulo || 'Lección';
const crumb   = leccion?.data?.crumb || '';
const modulo  = leccion?.data?.modulo || 'M0';
const leccionId = leccion?.data?.id || leccion?.id;
const generadoPor = leccion?.data?.generado_por || 'demo';
---

<Base title={`${titulo} · raíz_`} tag={leccionId} view="leccion">
  <section class="view enter">
    <div class="lread">
      <a class="backlink" href={`/m/${modulo}`}>← módulo</a>
      <div class="crumb">{crumb}</div>
      <h2>{titulo}</h2>

      {Content ? (
        <article class="leccion-cuerpo">
          <Content />
        </article>
      ) : (
        <p style="color:var(--muted);">Lección en construcción. Vuelve en unos minutos.</p>
      )}

      {leccion?.data?.lab?.tipo === 'toggle' && (
        <Toggle pregunta={leccion.data.lab.descripcion} />
      )}

      {leccion?.data?.lab?.tipo === 'cipher_xor' && (
        <CipherXor
          texto_plano={leccion.data.lab.texto_plano}
          clave={leccion.data.lab.clave}
          cifrado={leccion.data.lab.cifrado}
        />
      )}

      <hr class="rule" />

      <aside class="progress-card" data-lesson-progress data-lesson-id={leccionId}>
        <div>
          <strong>Tu progreso en este dispositivo</strong>
          <p data-progress-copy>Marca la lección cuando termines. No necesitas crear una cuenta.</p>
        </div>
        <button class="btn" type="button" data-progress-button>Marcar como completada</button>
      </aside>

      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
        <a class="btn ghost" href={`/m/${modulo}`}>← módulo</a>
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--faint);">
          {generadoPor}
        </span>
      </div>
    </div>
  </section>
</Base>

<script>
  const card = document.querySelector('[data-lesson-progress]');
  if (card instanceof HTMLElement) {
    const lessonId = card.dataset.lessonId;
    const button = card.querySelector('[data-progress-button]');
    const copy = card.querySelector('[data-progress-copy]');
    const key = 'raiz.completedLessons';
    const read = () => {
      try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')); }
      catch { return new Set(); }
    };
    const render = () => {
      const completed = read().has(lessonId);
      card.dataset.completed = String(completed);
      if (button) button.textContent = completed ? 'Completada ✓' : 'Marcar como completada';
      if (copy) copy.textContent = completed ? 'Guardada localmente. Puedes desmarcarla si quieres repetirla.' : 'Marca la lección cuando termines. No necesitas crear una cuenta.';
    };
    button?.addEventListener('click', () => {
      const completed = read();
      if (completed.has(lessonId)) completed.delete(lessonId);
      else completed.add(lessonId);
      localStorage.setItem(key, JSON.stringify([...completed]));
      render();
    });
    render();
  }
</script>

<style>
  .progress-card { display:flex; justify-content:space-between; align-items:center; gap:18px; margin:24px 0; padding:16px; border:1px solid var(--line); border-radius:10px; background:var(--paper); }
  .progress-card p { margin:4px 0 0; color:var(--muted); font-size:13px; }
  .progress-card[data-completed="true"] { border-color:var(--accent); background:var(--accent-soft); }
  @media (max-width: 620px) { .progress-card { align-items:stretch; flex-direction:column; } }
  .leccion-cuerpo :global(h1) { display: none; }
  .leccion-cuerpo :global(h2) {
    font-size: 22px; font-weight: 680; letter-spacing: -.02em;
    margin: 32px 0 14px; text-wrap: balance;
  }
  .leccion-cuerpo :global(h3) {
    font-size: 17px; font-weight: 650; margin: 24px 0 10px;
  }
  .leccion-cuerpo :global(p) {
    font-size: 17px; line-height: 1.7; color: #27272a;
    margin: 0 0 18px; text-wrap: pretty;
  }
  .leccion-cuerpo :global(ul),
  .leccion-cuerpo :global(ol) {
    font-size: 17px; line-height: 1.7; color: #27272a;
    margin: 0 0 18px; padding-left: 24px;
  }
  .leccion-cuerpo :global(li) { margin-bottom: 6px; }
  .leccion-cuerpo :global(code) {
    font-family: ui-monospace, Menlo, monospace; font-size: 14px;
    background: var(--paper); border: 1px solid var(--line);
    border-radius: 4px; padding: 1px 6px;
  }
  .leccion-cuerpo :global(pre) {
    font-family: ui-monospace, Menlo, monospace; font-size: 13px;
    background: var(--paper); border: 1px solid var(--line);
    border-radius: 10px; padding: 16px; overflow-x: auto; margin: 18px 0;
  }
  .leccion-cuerpo :global(pre code) { background: transparent; border: 0; padding: 0; }
  .leccion-cuerpo :global(blockquote) {
    border-left: 3px solid var(--accent); margin: 18px 0;
    padding: 4px 16px; color: var(--muted); font-style: italic;
  }
  .leccion-cuerpo :global(strong) { font-weight: 650; color: var(--ink); }
  .leccion-cuerpo :global(.term) {
    color: var(--accent); border-bottom: 1px dashed var(--accent); text-decoration: none;
  }
  .leccion-cuerpo :global(.term:hover) { background: var(--accent-soft); }
</style>
